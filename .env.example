
# SERVI-RED - Variables de entorno de ejemplo
# Copiar a .env.local y completar con valores propios.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL
DATABASE_URL=

# RabbitMQ
RABBITMQ_URL=

# Microservicio de indicadores: solo para el servidor, nunca NEXT_PUBLIC_.
# En desarrollo: npm run setup:indicadores genera la configuración privada.
# En Vercel: URL HTTPS del servicio desplegado (sin /v1/continuidad).
INDICADORES_SERVICE_URL=http://127.0.0.1:4001
INDICADORES_API_KEY=
